{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuntimeState",
  "type": "object",
  "required": ["runId", "phase", "attempts", "humanApproved"],
  "properties": {
    "runId": {"type": "string"},
    "phase": {"type": "string"},
    "attempts": {"type": "integer", "minimum": 0},
    "humanApproved": {"type": "boolean"},
    "issues": {"type": "array", "items": {"type": "string"}}
  }
}
